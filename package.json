{
  "name": "vibefox",
  "version": "0.1.0",
  "private": true,
  "description": "An independent AI agent individual with its own identity (email, phone, wallet) that lives on your Mac.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "vf": "./bin/vf.ts"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test --test-concurrency=1 'test/unit/*.test.ts' 'test/integration/*.test.ts'",
    "test:unit": "node --test 'test/unit/*.test.ts'",
    "test:integration": "node --test --test-concurrency=1 'test/integration/*.test.ts'",
    "secrets": "gitleaks git --config .gitleaks.toml --redact --no-banner"
  },
  "dependencies": {
    "@stripe/link-cli": "^0.30.0",
    "playwright": "^1.64.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Dongyu-Jia/vibefox.git"
  },
  "homepage": "https://github.com/Dongyu-Jia/vibefox#readme",
  "bugs": {
    "url": "https://github.com/Dongyu-Jia/vibefox/issues"
  }
}
