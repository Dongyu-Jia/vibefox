# The parent's keys for this Mac. Copy to .env.local (gitignored, kept 0600):
#   cp .env.example .env.local && chmod 600 .env.local
# or run `./bin/vf keys`, which checks each key live and writes .env.local for you.
# `vf init` offers these to the new agent; each agent then keeps its own copy in the macOS Keychain.
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
TELEGRAM_BOT_TOKEN=
AGENTMAIL_API_KEY=
AGENTPHONE_API_KEY=
